    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
